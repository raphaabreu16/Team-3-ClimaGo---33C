*{
    margin: 0;
    padding: 0;
    box-sizing: border-box;
    font-family: Arial, Helvetica, sans-serif;
}

body{
    background-color: #f2f4f8;

    display: flex;
    justify-content: center;
    align-items: center;

    height: 100vh;
}

.container{
    width: 420px;
}

.titulo{
    margin-bottom: 20px;
}

.titulo h1{
    font-size: 30px;
    margin-bottom: 5px;
}

.titulo p{
    color: gray;
}

.mes{
    background-color: white;

    padding: 15px;

    border-radius: 15px;

    display: flex;
    justify-content: space-between;
    align-items: center;

    margin-bottom: 20px;
}

.mes button{
    width: 35px;
    height: 35px;

    border: none;
    border-radius: 50%;

    background-color: #f0f2f5;

    cursor: pointer;
}

.calendario{
    background-color: white;

    padding: 20px;

    border-radius: 20px;
}

.dias-semana{
    display: grid;
    grid-template-columns: repeat(7, 1fr);

    text-align: center;

    margin-bottom: 20px;

    color: gray;
    font-size: 14px;
}

.dias{
    display: grid;
    grid-template-columns: repeat(7, 1fr);

    gap: 10px;
}

.dia{
    height: 70px;

    border-radius: 12px;

    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;

    cursor: pointer;

    transition: 0.3s;
}

.dia:hover{
    background-color: #f1f5ff;
}

.dia span{
    font-weight: bold;
}

.dia p{
    color: #ff7b00;
    font-size: 14px;
}

.selecionado{
    border: 2px solid #4a90ff;
    background-color: #eef5ff;
}

.legenda{
    background-color: white;

    margin-top: 20px;

    padding: 20px;

    border-radius: 15px;
}

.legenda h3{
    margin-bottom: 15px;
}

.cores{
    display: flex;
    gap: 20px;

    font-size: 14px;
}

.cores div{
    display: flex;
    align-items: center;
    gap: 5px;
}

.verde,
.amarelo,
.vermelho{
    width: 12px;
    height: 12px;

    border-radius: 50%;

    display: inline-block;
}

.verde{
    background-color: green;
}

.amarelo{
    background-color: orange;
}

.vermelho{
    background-color: red;
}
